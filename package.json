{
	"name": "@juicerq/jubs",
	"version": "0.0.0",
	"description": "A typed job library over BullMQ",
	"license": "MIT",
	"author": "juicerq",
	"type": "module",
	"sideEffects": false,
	"homepage": "https://github.com/juicerq/jubs#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/juicerq/jubs.git"
	},
	"bugs": {
		"url": "https://github.com/juicerq/jubs/issues"
	},
	"keywords": [
		"bullmq",
		"jobs",
		"queue",
		"typescript",
		"background-jobs"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./testing": {
			"types": "./dist/testing.d.ts",
			"import": "./dist/testing.js"
		},
		"./dashboard": {
			"types": "./dist/dashboard.d.ts",
			"import": "./dist/dashboard.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=20",
		"bun": ">=1.2"
	},
	"scripts": {
		"build": "tsdown",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "bun test test/unit",
		"test:integration": "bun test test/integration",
		"smoke": "node scripts/smoke.mjs",
		"prepack": "bun run build",
		"release": "bun run build && changeset publish"
	},
	"peerDependencies": {
		"@bull-board/api": "^8.6.0",
		"@bull-board/express": "^8.6.0",
		"@bull-board/fastify": "^8.6.0",
		"bullmq": "^6.0.11"
	},
	"peerDependenciesMeta": {
		"@bull-board/api": {
			"optional": true
		},
		"@bull-board/express": {
			"optional": true
		},
		"@bull-board/fastify": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@bull-board/api": "8.6.0",
		"@bull-board/express": "8.6.0",
		"@bull-board/fastify": "8.6.0",
		"@changesets/cli": "^3.0.0",
		"@types/bun": "^1.3.14",
		"@types/node": "^26.2.0",
		"arktype": "^2.2.3",
		"bullmq": "^6.0.11",
		"ioredis": "^6.0.0",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@standard-schema/spec": "^1.1.0"
	}
}
